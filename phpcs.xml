<?xml version="1.0"?>
<ruleset name="QuickPOS Coding Standard">
    <description>QuickPOS PHP coding standards</description>
    <rule ref="PSR12"/>
    <file>src</file>
    <file>tests</file>
    <file>process-contact.php</file>
    <file>index.php</file>
    <file>config.php</file>

    <!-- template/legacy files: long lines are unavoidable -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>index\.php</exclude-pattern>
        <exclude-pattern>process-contact\.php</exclude-pattern>
    </rule>
</ruleset>
